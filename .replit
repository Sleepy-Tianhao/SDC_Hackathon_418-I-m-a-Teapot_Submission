entrypoint = "src/main.py"
modules = ["nodejs-20", "python-3.12", "web", "nix"]
run = "PORT=5000 python src/main.py"

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "libxcrypt"]

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["python3", "-m", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "5000"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 python src/main.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

