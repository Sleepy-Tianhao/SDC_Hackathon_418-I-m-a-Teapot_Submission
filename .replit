entrypoint = "src/main.py"
modules = ["nodejs-20", "python-3.12", "web", "nix"]
run = "PORT=3000 python src/main.py"

[nix]
channel = "stable-25_05"

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["python3", "src/main.py"]
deploymentTarget = "cloudrun"

[[ports]]
internalPort = 3000
externalPort = 80
