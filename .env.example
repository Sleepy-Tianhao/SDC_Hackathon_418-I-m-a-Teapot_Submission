# Copy this file to .env locally, or add the values to Replit Secrets.
# Never commit a real .env — it is git-ignored.

PROJECT_NAME=AI Career Navigator
# Bind on all interfaces for Replit/local containers; Replit supplies PORT.
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/app.db

# Optional: comma-separated origins when the UI is hosted separately
CORS_ORIGINS=

# Online LLM provider (OpenAI-compatible chat completions endpoint)
# Examples:
#   DeepSeek:  https://api.deepseek.com      deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Faster non-reasoning model for JSON scoring and pathway calls
LLM_STRUCTURED_MODEL=deepseek-chat
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
# Share of the final role fit supplied by the LLM (0.5 = 50/50 blend)
AI_SCORE_WEIGHT=0.5
