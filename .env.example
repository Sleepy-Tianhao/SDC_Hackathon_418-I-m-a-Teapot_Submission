# Copy this file to .env for local development (or use Replit Secrets in production).
# Never commit a real .env — it is git-ignored.

PROJECT_NAME=AI Career Navigator

# Backend
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_PATH=data/app.db

# Third-party model provider (server-side only, OpenAI-compatible endpoint)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=25
# Optional sampling controls, if supported by your provider
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900

# src/main.py reads DEEPSEEK_API_KEY first and falls back to LLM_API_KEY, so set
# either one. DEEPSEEK_BASE_URL is optional (defaults to https://api.deepseek.com).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
